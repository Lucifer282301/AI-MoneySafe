NODE_ENV=development
PORT=4000

# PostgreSQL connection string
DATABASE_URL="postgresql://username:password@localhost:5432/moneysafe?schema=public"

# Auth. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30

# Gemini: models are tried left to right. Check aistudio.google.com for current model names.
GEMINI_API_KEY=""
GEMINI_MODELS="gemini-3.5-flash,gemini-3.5-flash-lite,gemini-2.5-flash"

# Cloudinary (optional): receipts and profile photos
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Firebase service account key, Base64-encoded (optional): push notifications
FIREBASE_SERVICE_ACCOUNT_BASE64=""

# Comma-separated browser origins allowed by CORS. Leave empty for mobile-only use.
CORS_ORIGINS=""
