generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

// ========================================== 
// USER 
// ==========================================
model User {
    id            String         @id @default(cuid())
    name          String
    email         String         @unique
    password      String
    currency      String         @default("INR") // User's preferred/default currency  // ISO 4217: INR, USD, EUR, GBP...
    createdAt     DateTime       @default(now())
    updatedAt     DateTime       @updatedAt
    pushToken     String? // Expo push notification token 
    transactions  Transaction[]
    budgets       Budget[]
    refreshTokens RefreshToken[]

    @@map("users")
}

// ========================================== 
// TRANSACTION TYPE 
// ==========================================
enum TransactionType {
    DEBIT
    CREDIT
}

// ========================================== 
// CATEGORY 
// ==========================================
enum Category {
    FOOD
    TRANSPORT
    SHOPPING
    ENTERTAINMENT
    BILLS
    HEALTH
    EDUCATION
    OTHER
}

// ========================================== 
// TRANSACTION 
// ==========================================
model Transaction {
    id           String          @id @default(cuid())
    merchant     String
    amount       Float // Original transaction amount
    currency     String          @default("INR") // Currency in which transaction actually happened
    amountBase   Float? // Amount converted to USD for reports/AI
    exchangeRate Float?          @default(1.0) // Currency -> USD conversion rate
    category     Category
    type         TransactionType @default(DEBIT)
    note         String?
    date         DateTime
    receiptUrl   String?
    createdAt    DateTime        @default(now())
    userId       String
    user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId, date])
    @@map("transactions")
}

// ========================================== 
// BUDGET 
// ==========================================
model Budget {
    id        String        @id @default(cuid())
    category  Category
    limit     Float
    createdAt DateTime      @default(now())
    updatedAt DateTime      @updatedAt
    userId    String
    user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
    alerts    BudgetAlert[]

    // One budget per category per user 
    @@unique([userId, category])
    @@map("budgets")
}

// ========================================== 
// BUDGET ALERT 
// ==========================================
model BudgetAlert {
    id        String   @id @default(cuid())
    budgetId  String
    threshold Int
    month     String
    sentAt    DateTime @default(now())
    budget    Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)

    @@unique([budgetId, threshold, month])
    @@map("budget_alerts")
}

// ========================================== 
// REFRESH TOKEN 
// ==========================================
model RefreshToken {
    id        String   @id @default(cuid())
    token     String   @unique
    userId    String
    expiresAt DateTime
    createdAt DateTime @default(now())
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@map("refresh_tokens")
}
