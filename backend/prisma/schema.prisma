generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

// ========================================== 
// USER 
// ==========================================
model User {
    id            String         @id @default(cuid())
    name          String
    email         String         @unique
    password      String
    createdAt     DateTime       @default(now())
    updatedAt     DateTime       @updatedAt
    // Expo push notification token 
    pushToken     String?
    transactions  Transaction[]
    budgets       Budget[]
    refreshTokens RefreshToken[]

    @@map("users")
}

// ========================================== 
// TRANSACTION TYPE 
// ==========================================
enum TransactionType {
    DEBIT
    CREDIT
}

// ========================================== 
// CATEGORY 
// ==========================================
enum Category {
    FOOD
    TRANSPORT
    SHOPPING
    ENTERTAINMENT
    BILLS
    HEALTH
    EDUCATION
    OTHER
}

// ========================================== 
// TRANSACTION 
// ==========================================
model Transaction {
    id         String          @id @default(cuid())
    merchant   String
    amount     Float
    category   Category
    type       TransactionType @default(DEBIT)
    note       String?
    date       DateTime
    receiptUrl String?
    createdAt  DateTime        @default(now())

    userId String

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId, date])
    @@map("transactions")
}

// ========================================== 
// BUDGET 
// ==========================================
model Budget {
    id        String   @id @default(cuid())
    category  Category
    limit     Float
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    userId String

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    alerts BudgetAlert[]

    // One budget per category per user 
    @@unique([userId, category])
    @@map("budgets")
}

// ========================================== 
// BUDGET ALERT 
// ==========================================
model BudgetAlert {
    id        String   @id @default(cuid())
    budgetId  String
    threshold Int
    month     String
    sentAt    DateTime @default(now())

    budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

    // Example: 
    // budgetId + 80 + 2026-09 
    // budgetId + 100 + 2026-09 

    // Same budget can receive alerts again 
    // when a new month starts. 
    @@unique([budgetId, threshold, month])
    @@map("budget_alerts")
}

// ========================================== 
// REFRESH TOKEN 
// ==========================================
model RefreshToken {
    id        String   @id @default(cuid())
    token     String   @unique
    userId    String
    expiresAt DateTime
    createdAt DateTime @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@map("refresh_tokens")
}
